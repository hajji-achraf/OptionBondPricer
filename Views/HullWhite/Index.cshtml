    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Variables globales
        let darkMode = localStorage.getItem('darkMode') === 'true'; // État initial du mode sombre
        let charts = {}; // Pour stocker les références aux graphiques Chart.js

        // Animation des éléments lors du chargement
        document.addEventListener('DOMContentLoaded', function() {
            // Appliquer le mode sombre si nécessaire
            if (darkMode) {
                document.body.classList.add('dark-mode');
                document.getElementById('themeToggle').innerHTML = '<i class="bi bi-sun"></i>';
            }

            // Initialisation des événements
            initializeEvents();

            // Initialiser le slider de simulations
            const simulationSlider = document.getElementById('simulation-paths');
            const simulationValue = document.getElementById('simulation-value');
            simulationValue.textContent = simulationSlider.value;

            simulationSlider.addEventListener('input', function() {
                simulationValue.textContent = parseInt(this.value).toLocaleString();
            });

            // Activer le basculement du thème
            document.getElementById('themeToggle') && document.getElementById('themeToggle').addEventListener('click', toggleDarkMode);

            // Initialiser les boutons de repli des sections
            initializeCollapseSections();

            // Animation du titre de l'application
            animateAppTitle();
            
            // Initialiser la prévisualisation de la fonction theta personnalisée
            document.getElementById('theta-custom').addEventListener('change', updateCustomFunctionPreview);
            updateCustomFunctionPreview();
        });

        // Mise à jour de la prévisualisation de la fonction personnalisée
        function updateCustomFunctionPreview() {
            const select = document.getElementById('theta-custom');
            const preview = document.getElementById('custom-function-preview');
            
            switch(select.value) {
                case 'linear':
                    preview.textContent = 'θ(t) = 0.05 + 0.005 × t';
                    break;
                case 'sin':
                    preview.textContent = 'θ(t) = 0.05 + 0.01 × sin(t)';
                    break;
                case 'exp':
                    preview.textContent = 'θ(t) = 0.05 × e^(0.1 × t)';
                    break;
                case 'step':
                    preview.textContent = 'θ(t) = t < 5 ? 0.04 : 0.06';
                    break;
            }
        }

        // Mise à jour des options de theta en fonction du type de fonction
        function updateThetaOptions() {
            const functionType = document.getElementById('theta-function-type').value;
            
            // Masquer toutes les options
            document.querySelectorAll('.theta-function-options').forEach(el => {
                el.style.display = 'none';
            });
            
            // Afficher les options correspondant au type sélectionné
            document.getElementById(functionType + '-options').style.display = 'block';
        }

        // Animation du titre de l'application
        function animateAppTitle() {
            const appTitle = document.querySelector('.app-title');
            if (appTitle) {
                appTitle.style.opacity = '0';
                appTitle.style.transform = 'translateY(-20px)';

                setTimeout(() => {
                    appTitle.style.transition = 'all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
                    appTitle.style.opacity = '1';
                    appTitle.style.transform = 'translateY(0)';
                }, 200);
            }
        }

        // Fonction pour initialiser les boutons de repli
        function initializeCollapseSections() {
            document.querySelectorAll('.collapse-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const targetId = this.getAttribute('data-target');
                    const targetElement = document.getElementById(targetId);

                    if (targetElement.style.display === 'none') {
                        targetElement.style.display = 'block';
                        this.innerHTML = '<i class="bi bi-chevron-up"></i>';
                    } else {
                        targetElement.style.display = 'none';
                        this.innerHTML = '<i class="bi bi-chevron-down"></i>';
                    }
                });
            });
        }

        // Basculer le mode sombre
        function toggleDarkMode() {
            darkMode = !darkMode;
            document.body.classList.toggle('dark-mode');

            const themeToggle = document.getElementById('themeToggle');
            if (themeToggle) {
                themeToggle.innerHTML = darkMode ? '<i class="bi bi-sun"></i>' : '<i class="bi bi-moon"></i>';
            }

            // Sauvegarder la préférence
            localStorage.setItem('darkMode', darkMode);

            // Mettre à jour les graphiques si nécessaires
            updateChartTheme();
        }

        // Mettre à jour le thème des graphiques
        function updateChartTheme() {
            Object.values(charts).forEach(chart => {
                if (chart && typeof chart.update === 'function') {
                    // Mettre à jour les couleurs du graphique selon le thème
                    chart.options.scales.x.grid.color = darkMode ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)';
                    chart.options.scales.y.grid.color = darkMode ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)';
                    chart.options.scales.x.ticks.color = darkMode ? '#e5e5e5' : '#333';
                    chart.options.scales.y.ticks.color = darkMode ? '#e5e5e5' : '#333';
                    chart.update();
                }
            });

            // Mettre à jour Plotly 3D si présent
            var rateCurveElement = document.getElementById('rateCurveChart');
            if (rateCurveElement && rateCurveElement.data) {
                var paperColor = darkMode ? '#1a2530' : '#ffffff';
                var textColor = darkMode ? '#e5e5e5' : '#333333';

                Plotly.relayout(rateCurveElement, {
                    'paper_bgcolor': paperColor,
                    'plot_bgcolor': paperColor,
                    'font.color': textColor,
                    'scene.xaxis.color': textColor,
                    'scene.yaxis.color': textColor,
                    'scene.zaxis.color': textColor
                });
            }
        }

        // Initialisation des événements
        function initializeEvents() {
            // Formulaire de simulation
            document.getElementById('simulation-form').addEventListener('submit', function(e) {
                e.preventDefault();
                simulateRates();
            });
            
            // Initialiser l'affichage des options de fonction theta
            updateThetaOptions();
        }

        // Affichage des messages d'erreur
        function showError(message) {
            const errorElement = document.getElementById('error-message');
            errorElement.textContent = message;
            errorElement.style.display = 'block';

            // Scroll vers le message d'erreur
            errorElement.scrollIntoView({ behavior: 'smooth', block: 'center' });

            // Masquer après 5 secondes
            setTimeout(() => {
                errorElement.style.display = 'none';
            }, 5000);
        }

        // Affichage du chargement
        function showLoading(message = 'Chargement...') {
            document.getElementById('loadingText').textContent = message;
            document.getElementById('loadingOverlay').classList.add('active');
        }

        function hideLoading() {
            document.getElementById('loadingOverlay').classList.remove('active');
        }

        // Simulation des taux
        function simulateRates() {
            // Collecter les paramètres du formulaire
            const meanReversion = parseFloat(document.getElementById('mean-reversion').value);
            const volatility = parseFloat(document.getElementById('volatility').value);
            const currentRate = parseFloat(document.getElementById('current-rate').value);
            const timeHorizon = parseFloat(document.getElementById('time-horizon').value);
            const timeSteps = parseInt(document.getElementById('time-steps').value);
            const simulationPaths = parseInt(document.getElementById('simulation-paths').value);
            const showConfidence = document.getElementById('show-confidence').checked;

            // Validation des paramètres
            if (isNaN(meanReversion) || meanReversion <= 0) {
                showError('La vitesse de retour à la moyenne doit être un nombre positif');
                return;
            }
            if (isNaN(volatility) || volatility <= 0) {
                showError('La volatilité doit être un nombre positif');
                return;
            }
            if (isNaN(currentRate) || currentRate < 0) {
                showError('Le taux actuel doit être un nombre positif ou nul');
                return;
            }

            // Collecter les paramètres de la fonction theta
            const thetaType = document.getElementById('theta-function-type').value;
            let thetaParams = {};
            
            switch(thetaType) {
                case 'constant':
                    thetaParams = {
                        type: 'constant',
                        value: parseFloat(document.getElementById('theta-constant').value) / 100
                    };
                    break;
                case 'linear':
                    thetaParams = {
                        type: 'linear',
                        initial: parseFloat(document.getElementById('theta-linear-initial').value) / 100,
                        final: parseFloat(document.getElementById('theta-linear-final').value) / 100
                    };
                    break;
                case 'exponential':
                    thetaParams = {
                        type: 'exponential',
                        initial: parseFloat(document.getElementById('theta-exp-initial').value) / 100,
                        rate: parseFloat(document.getElementById('theta-exp-rate').value)
                    };
                    break;
                case 'sinusoidal':
                    thetaParams = {
                        type: 'sinusoidal',
                        mean: parseFloat(document.getElementById('theta-sin-initial').value) / 100,
                        amplitude: parseFloat(document.getElementById('theta-sin-amplitude').value) / 100,
                        period: parseFloat(document.getElementById('theta-sin-period').value)
                    };
                    break;
                case 'custom':
                    thetaParams = {
                        type: 'custom',
                        formula: document.getElementById('theta-custom').value
                    };
                    break;
            }

            showLoading('Simulation des trajectoires de taux avec Hull-White...');

            // Dans un environnement réel, on ferait un appel API ici
            // Pour l'exemple, on simule la réponse avec un timeout
            setTimeout(() => {
                // Simuler les résultats du modèle Hull-White
                const results = simulateHullWhiteModel(
                    meanReversion,
                    thetaParams,
                    volatility,
                    currentRate,
                    timeHorizon,
                    timeSteps,
                    simulationPaths
                );

                hideLoading();

                // Masquer le message "pas de résultats" et afficher la section de résultats
                document.getElementById('no-results').style.display = 'none';
                document.getElementById('results-content').style.display = 'block';

                // Afficher les résultats avec animation
                displayResults(results);

                // Créer les graphiques
                createCharts(results, showConfidence);

            }, 1500); // Simulation d'un délai de traitement
        }

        // Fonction pour calculer theta à un temps t spécifique
        function calculateTheta(t, params) {
            switch(params.type) {
                case 'constant':
                    return params.value;

                case 'linear':
                    // Interpolation linéaire entre params.initial et params.final
                    const timeHorizon = parseFloat(document.getElementById('time-horizon').value);
                    return params.initial + (params.final - params.initial) * (t / timeHorizon);

                case 'exponential':
                    // Croissance/décroissance exponentielle
                    return params.initial * Math.exp(params.rate * t);

                case 'sinusoidal':
                    // Fonction sinusoïdale
                    return params.mean + params.amplitude * Math.sin((2 * Math.PI * t) / params.period);

                case 'custom':
                    // Fonctions personnalisées prédéfinies
                    switch(params.formula) {
                        case 'linear':
                            return 0.05 + 0.005 * t;
                        case 'sin':
                            return 0.05 + 0.01 * Math.sin(t);
                        case 'exp':
                            return 0.05 * Math.exp(0.1 * t);
                        case 'step':
                            return t < 5 ? 0.04 : 0.06;
                        default:
                            return 0.05;
                    }

                default:
                    return 0.05; // Valeur par défaut
            }
        }

        // Simulation du modèle Hull-White (où theta dépend du temps)
        function simulateHullWhiteModel(alpha, thetaParams, sigma, r0, timeHorizon, timeSteps, paths) {
            // Convertir les pourcentages en décimal
            sigma = sigma / 100;
            r0 = r0 / 100;

            const dt = timeHorizon / timeSteps;
            const sqrtDt = Math.sqrt(dt);

            // Initialiser les tableaux de temps et de taux
            const times = Array.from({length: timeSteps + 1}, (_, i) => i * dt);
            const rates = Array(paths).fill().map(() => Array(timeSteps + 1).fill(0));

            // Initialiser tous les chemins avec le taux initial
            for (let p = 0; p < paths; p++) {
                rates[p][0] = r0;
            }

            // Générer les valeurs de theta pour chaque pas de temps
            const thetaValues = times.map(t => calculateTheta(t, thetaParams));

            // Simuler les trajectoires
            for (let p = 0; p < paths; p++) {
                for (let t = 1; t <= timeSteps; t++) {
                    // Générer un nombre aléatoire normal
                    let z = randomNormal();

                    // Appliquer le modèle Hull-White (discrétisé)
                    // La différence clé avec Vasicek: theta dépend du temps
                    const thetaT = thetaValues[t-1];
                    rates[p][t] = rates[p][t-1] + alpha * (thetaT - rates[p][t-1]) * dt + sigma * sqrtDt * z;

                    // S'assurer que le taux reste positif (pour simplifier)
                    rates[p][t] = Math.max(0, rates[p][t]);
                }
            }

            // Calculer la trajectoire moyenne
            const meanRates = Array(timeSteps + 1).fill(0);
            for (let t = 0; t <= timeSteps; t++) {
                let sum = 0;
                for (let p = 0; p < paths; p++) {
                    sum += rates[p][t];
                }
                meanRates[t] = sum / paths;
            }

            // Calculer les bornes de l'intervalle de confiance à 95%
            const confidenceLower = Array(timeSteps + 1).fill(0);
            const confidenceUpper = Array(timeSteps + 1).fill(0);

            for (let t = 0; t <= timeSteps; t++) {
                const ratesAtT = rates.map(r => r[t]);
                ratesAtT.sort((a, b) => a - b);

                confidenceLower[t] = ratesAtT[Math.floor(paths * 0.025)];
                confidenceUpper[t] = ratesAtT[Math.floor(paths * 0.975)];
            }

            // Calculer des statistiques sur le taux à la fin de la simulation
            const finalRates = rates.map(r => r[timeSteps]);
            const shortTermRate = finalRates.reduce((sum, r) => sum + r, 0) / paths;

            // Calculer la courbe des taux zéro-coupon
            const yieldCurve = calculateHullWhiteYieldCurve(alpha, thetaParams, sigma, r0, timeHorizon, 20);

            return {
                times,
                rates,
                meanRates,
                confidenceLower,
                confidenceUpper,
                shortTermRate,
                averageRate: meanRates.reduce((sum, r) => sum + r, 0) / (timeSteps + 1),
                alpha,
                sigma,
                r0,
                thetaParams,
                thetaValues,
                yieldCurve
            };
        }

        // Fonction pour générer un nombre aléatoire normal (Box-Muller)
        function randomNormal() {
            let u = 0, v = 0;
            while (u === 0) u = Math.random();
            while (v === 0) v = Math.random();
            return Math.sqrt(-2.0 * Math.log(u)) * Math.cos(2.0 * Math.PI * v);
        }

        // Calculer la courbe des taux zéro-coupon pour Hull-White
        function calculateHullWhiteYieldCurve(alpha, thetaParams, sigma, r0, maxT, points) {
            const maturities = [];
            const yields = [];

            // Convertir en décimal
            sigma = sigma / 100;
            r0 = r0 / 100;

            for (let i = 0; i <= points; i++) {
                const T = (i / points) * maxT;
                maturities.push(T);

                if (T === 0) {
                    yields.push(r0 * 100); // Convertir en pourcentage
                    continue;
                }

                // Pour Hull-White, calculer la moyenne de theta sur [0,T]
                let avgTheta = 0;
                const samples = 20; // Nombre d'échantillons pour l'intégration
                const dtIntegration = T / samples;

                for (let j = 0; j < samples; j++) {
                    const tj = j * dtIntegration;
                    avgTheta += calculateTheta(tj, thetaParams) * dtIntegration;
                }
                avgTheta /= T;

                // Formule simplifiée pour Hull-White
                const B = (1 - Math.exp(-alpha * T)) / alpha;
                const A = Math.exp((avgTheta - (sigma * sigma) / (2 * alpha * alpha)) * (B - T) - (sigma * sigma * B * B) / (4 * alpha));

                const zcRate = -Math.log(A) / T + B * r0 / T;
                yields.push(zcRate * 100); // Convertir en pourcentage
            }

            return { maturities, yields };
        }

        // Afficher les résultats
        function displayResults(results) {
            // Formater les valeurs en pourcentages avec 2 décimales
            const formatPercent = (value) => (value * 100).toFixed(2) + '%';

            // Mettre à jour les affichages avec animation
            animateValue('short-term-rate', 0, results.shortTermRate * 100, '%');
            animateValue('average-rate', 0, results.averageRate * 100, '%');

            // Mettre à jour les paramètres du modèle
            animateValue('alpha-value', 0, results.alpha, '');
            animateValue('sigma-value', 0, results.sigma * 100, '%');
            animateValue('r0-value', 0, results.r0 * 100, '%');
        }

        // Animation pour l'affichage des valeurs
        function animateValue(elementId, start, end, suffix = '') {
            const element = document.getElementById(elementId);
            if (!element) return;

            const duration = 1000; // 1 seconde
            const startTime = performance.now();

            function updateValue(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);

                // Fonction d'easing
                const easeOutQuad = progress * (2 - progress);
                const value = start + (end - start) * easeOutQuad;

                element.textContent = value.toFixed(2) + suffix;

                if (progress < 1) {
                    requestAnimationFrame(updateValue);
                } else {
                    // Ajouter un petit effet de rebond à la fin
                    element.style.transform = 'scale(1.05)';
                    setTimeout(() => {
                        element.style.transition = 'transform 0.2s ease-out';
                        element.style.transform = 'scale(1)';
                    }, 50);
                }
            }

            requestAnimationFrame(updateValue);
        }

        // Créer les graphiques
        function createCharts(results, showConfidence) {
            // Détruire les graphiques existants s'ils existent
            Object.values(charts).forEach(chart => {
                if (chart) chart.destroy();
            });

            // Configuration commune pour tous les graphiques
            const chartConfig = {
                responsive: true,
                maintainAspectRatio: false,
                animation: {
                    duration: 1000
                },
                plugins: {
                    legend: {
                        labels: {
                            color: darkMode ? '#e5e5e5' : '#333'
                        }
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        backgroundColor: darkMode ? '#2c3e50' : 'white',
                        titleColor: darkMode ? '#ecf0f1' : '#2c3e50',
                        bodyColor: darkMode ? '#ecf0f1' : '#2c3e50',
                        borderColor: darkMode ? '#1a2530' : '#e9ecef',
                        borderWidth: 1
                    }
                },
                scales: {
                    x: {
                        grid: {
                            color: darkMode ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)'
                        },
                        ticks: {
                            color: darkMode ? '#e5e5e5' : '#333'
                        }
                    },
                    y: {
                        grid: {
                            color: darkMode ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)'
                        },
                        ticks: {
                            color: darkMode ? '#e5e5e5' : '#333'
                        }
                    }
                }
            };

            // 1. Graphique de la fonction theta
            const thetaCtx = document.getElementById('theta-chart').getContext('2d');

            // Convertir theta en pourcentage pour l'affichage
            const thetaValuesPercent = results.thetaValues.map(t => t * 100);

            charts.theta = new Chart(thetaCtx, {
                type: 'line',
                data: {
                    labels: results.times.map(t => t.toFixed(1) + ' ans'),
                    datasets: [{
                        label: 'θ(t) - Taux d\'équilibre',
                        data: thetaValuesPercent,
                        borderColor: '#e67e22',
                        backgroundColor: 'rgba(230, 126, 34, 0.2)',
                        borderWidth: 3,
                        tension: 0.3,
                        fill: false
                    }]
                },
                options: {
                    ...chartConfig,
                    plugins: {
                        ...chartConfig.plugins,
                        title: {
                            display: true,
                            text: 'Fonction θ(t) dépendante du temps',
                            color: darkMode ? '#e5e5e5' : '#333'
                        }
                    },
                    scales: {
                        ...chartConfig.scales,
                        y: {
                            ...chartConfig.scales.y,
                            title: {
                                display: true,
                                text: 'Taux (%)',
                                color: darkMode ? '#e5e5e5' : '#333'
                            }
                        }
                    }
                }
            });

            // 2. Graphique des trajectoires de taux
            const rateCtx = document.getElementById('rate-chart').getContext('2d');

            // Convertir les taux en pourcentage pour l'affichage
            const meanRatesPercent = results.meanRates.map(r => r * 100);
            const confLowerPercent = results.confidenceLower.map(r => r * 100);
            const confUpperPercent = results.confidenceUpper.map(r => r * 100);

            // Sélectionner quelques trajectoires à afficher (pour ne pas surcharger le graphique)
            const samplesToShow = 5;
            const sampleRates = [];

            for (let i = 0; i < samplesToShow; i++) {
                const index = Math.floor(Math.random() * results.rates.length);
                sampleRates.push(results.rates[index].map(r => r * 100));
            }

            const rateData = {
                labels: results.times.map(t => t.toFixed(1) + ' ans'),
                datasets: [
                    {
                        label: 'Taux moyen',
                        data: meanRatesPercent,
                        borderColor: '#6b46c1',
                        backgroundColor: 'rgba(107, 70, 193, 0.2)',
                        borderWidth: 3,
                        tension: 0.3,
                        fill: false
                    }
                ]
            };

            // Ajouter les intervalles de confiance si demandé
            if (showConfidence) {
                rateData.datasets.push({
                    label: 'Intervalle de confiance 95%',
                    data: confLowerPercent,
                    borderColor: 'rgba(107, 70, 193, 0.3)',
                    backgroundColor: 'transparent',
                    borderWidth: 1,
                    borderDash: [5, 5],
                    pointRadius: 0,
                    tension: 0.3,
                    fill: '+1'
                });

                rateData.datasets.push({
                    label: 'Intervalle de confiance 95%',
                    data: confUpperPercent,
                    borderColor: 'rgba(107, 70, 193, 0.3)',
                    backgroundColor: 'rgba(107, 70, 193, 0.1)',
                    borderWidth: 1,
                    borderDash: [5, 5],
                    pointRadius: 0,
                    tension: 0.3,
                    fill: '-1'
                });
            }

            charts.rate = new Chart(rateCtx, {
                type: 'line',
                data: rateData,
                options: {
                    ...chartConfig,
                    plugins: {
                        ...chartConfig.plugins,
                        title: {
                            display: true,
                            text: 'Trajectoires de taux simulées',
                            color: darkMode ? '#e5e5e5' : '#333'
                        }
                    },
                    scales: {
                        ...chartConfig.scales,
                        y: {
                            ...chartConfig.scales.y,
                            title: {
                                display: true,
                                text: 'Taux (%)',
                                color: darkMode ? '#e5e5e5' : '#333'
                            }
                        }
                    }
                }
            });

            // Surface des taux 3D - agrandi pour occuper plus d'espace
            createRateSurface(results);
        }

        // Créer la surface des taux 3D
        function createRateSurface(results) {
            // Préparation des données pour la surface 3D
            const timeValues = results.times;
            const xValues = []; // Temps
            const yValues = []; // Maturités
            const zValues = []; // Taux

            // Générer les maturités (de 0 à 10 ans par pas de 0.5)
            const maturities = [];
            for (let i = 0; i <= 20; i++) {
                maturities.push(i * 0.5);
            }

            // Pour chaque point temporel
            for (let t = 0; t < timeValues.length; t += 5) { // Par pas de 5 pour ne pas surcharger
                const time = timeValues[t];

                // Récupérer le taux actuel à ce temps t
                const currentRate = results.meanRates[t];
                const thetaT = results.thetaValues[t]; // Nouveau: récupérer theta au temps t

                // Pour chaque maturité
                for (const maturity of maturities) {
                    // Ajouter les coordonnées
                    xValues.push(time);
                    yValues.push(maturity);

                    // Calculer le taux correspondant avec Hull-White
                    const rate = calculateHullWhiteRateAtTimeAndMaturity(
                        results.alpha,
                        thetaT,
                        results.sigma,
                        currentRate,
                        maturity
                    );

                    zValues.push(rate * 100); // Convertir en pourcentage
                }
            }

            // Configuration de la surface 3D - Agrandie
            const data = [{
                type: 'mesh3d',
                x: xValues,
                y: yValues,
                z: zValues,
                intensity: zValues,
                colorscale: 'Jet',
                opacity: 0.8
            }];

            const layout = {
                title: 'Surface des taux',
                scene: {
                    xaxis: {title: 'Temps (années)'},
                    yaxis: {title: 'Maturité (années)'},
                    zaxis: {title: 'Taux (%)'}
                },
                margin: {l: 0, r: 0, b: 0, t: 50},
                paper_bgcolor: darkMode ? '#1a2530' : '#ffffff',
                plot_bgcolor: darkMode ? '#1a2530' : '#ffffff',
                font: {
                    color: darkMode ? '#e5e5e5' : '#333333'
                },
                autosize: true // Permettre le redimensionnement automatique
            };

            // Créer ou mettre à jour le graphique Plotly
            Plotly.newPlot('rateCurveChart', data, layout, {responsive: true});

            // Redimensionner pour occuper tout l'espace disponible
            setTimeout(() => {
                Plotly.relayout('rateCurveChart', {});
            }, 100);
        }

        // Fonction pour calculer le taux Hull-White à un temps et une maturité donnés
        function calculateHullWhiteRateAtTimeAndMaturity(alpha, theta, sigma, currentRate, maturity) {
            // Formule simplifiée pour la démonstration
            if (maturity === 0) return currentRate;

            // Décroissance exponentielle du taux à court terme vers le taux à long terme
            const weight = Math.exp(-alpha * maturity);
            let rate = currentRate * weight + theta * (1 - weight);

            // Ajouter un terme de volatilité qui augmente avec la maturité
            rate += (sigma * Math.sqrt(maturity) * (Math.random() - 0.5) * 0.2);

            return Math.max(0, rate); // Ne pas permettre de taux négatifs
        }

        // Optimisations pour les appareils mobiles
        function setupMobileOptimizations() {
            // Vérifier si l'appareil est mobile (écran < 768px)
            const isMobile = window.innerWidth < 768;

            if (isMobile) {
                // Ajuster la taille des graphiques
                document.querySelectorAll('.chart-container').forEach(container => {
                    container.style.height = '250px';
                });

                // Simplifier l'interface
                document.querySelectorAll('.parameter-description').forEach(desc => {
                    desc.style.display = 'none';
                });

                // Adapter la grille unifiée pour mobile
                document.querySelector('.unified-container').style.display = 'block';
            }
        }

        // Appeler l'optimisation pour mobiles au chargement et au redimensionnement
        window.addEventListener('load', setupMobileOptimizations);
        window.addEventListener('resize', setupMobileOptimizations);

        // Mise à jour des informations de date et utilisateur
        function updateTimestampAndUser() {
            const timestampElements = document.querySelectorAll('.timestamp');
            const userElements = document.querySelectorAll('.user');

            timestampElements.forEach(el => {
                el.textContent = '2025-05-01 14:42:43';
            });

            userElements.forEach(el => {
                el.textContent = 'hajji-achraf';
            });
        }

        // Appeler la mise à jour au chargement
        window.addEventListener('load', updateTimestampAndUser);
    </script>
