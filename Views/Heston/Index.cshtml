            </div>
        </div>
    </footer>

    <!-- Bouton de basculement du thème -->
    <button id="themeToggle" class="theme-toggle">
        <i class="bi bi-moon"></i>
    </button>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Variables globales
        let allOptions = []; // Pour stocker toutes les options disponibles
        let charts = {}; // Pour stocker les références aux graphiques Chart.js
        let darkMode = localStorage.getItem('darkMode') === 'true'; // État initial du mode sombre
        let selectedOptionSymbol = null; // Pour stocker l'option actuellement sélectionnée
        let currentSurfaceType = 'volatility'; // Type de surface 3D (volatilité ou prix)

        // Animation des éléments lors du chargement
        document.addEventListener('DOMContentLoaded', function() {
            // Appliquer le mode sombre si nécessaire
            if (darkMode) {
                document.body.classList.add('dark-mode');
                document.getElementById('themeToggle').innerHTML = '<i class="bi bi-sun"></i>';
            }

            // Initialisation des événements
            initializeEvents();

            // Initialiser les sliders
            initializeSliders();

            // Activer le basculement du thème
            document.getElementById('themeToggle').addEventListener('click', toggleDarkMode);

            // Initialiser les boutons de repli des sections
            initializeCollapseSections();

            // Initialiser les boutons de surface
            initializeSurfaceToggle();
        });

        // Fonction pour initialiser les sliders des paramètres de Heston
        function initializeSliders() {
            // Slider pour les simulations Monte-Carlo
            const simulationsSlider = document.getElementById('simulations');
            const simulationsValue = document.getElementById('simulations-value');
            simulationsSlider.value = 10000;
            simulationsValue.textContent = '10,000';

            simulationsSlider.addEventListener('input', function() {
                simulationsValue.textContent = parseInt(this.value).toLocaleString();
            });

            // Sliders des paramètres de Heston
            initializeParameterSlider('kappa', 2);
            initializeParameterSlider('theta', 2);
            initializeParameterSlider('sigma', 2);
            initializeParameterSlider('rho', 2);
        }

        // Fonction pour initialiser un slider de paramètre
        function initializeParameterSlider(paramName, decimals) {
            const slider = document.getElementById(`${paramName}-slider`);
            const valueDisplay = document.getElementById(`${paramName}-value`);
            const hiddenInput = document.getElementById(paramName);

            slider.addEventListener('input', function() {
                const value = parseFloat(this.value);
                valueDisplay.textContent = value.toFixed(decimals);
                hiddenInput.value = value;
            });
        }

        // Fonction pour initialiser les boutons de basculement de surface
        function initializeSurfaceToggle() {
            document.querySelectorAll('.surface-toggle-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    // Mettre à jour le type de surface actuel
                    currentSurfaceType = this.getAttribute('data-surface');

                    // Mettre à jour les classes actives
                    document.querySelectorAll('.surface-toggle-btn').forEach(b => {
                        b.classList.remove('active');
                    });
                    this.classList.add('active');

                    // Recréer la surface si des données sont disponibles
                    if (document.getElementById('plot3d').data) {
                        updateVolatilitySurface();
                    }
                });
            });
        }

        // Fonction pour initialiser les boutons de repli
        function initializeCollapseSections() {
            document.querySelectorAll('.collapse-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const targetId = this.getAttribute('data-target');
                    const targetElement = document.getElementById(targetId);

                    if (targetElement.style.display === 'none') {
                        targetElement.style.display = 'block';
                        this.innerHTML = '<i class="bi bi-chevron-up"></i>';
                    } else {
                        targetElement.style.display = 'none';
                        this.innerHTML = '<i class="bi bi-chevron-down"></i>';
                    }
                });
            });
        }

        // Basculer le mode sombre
        function toggleDarkMode() {
            darkMode = !darkMode;
            document.body.classList.toggle('dark-mode');

            const themeToggle = document.getElementById('themeToggle');
            themeToggle.innerHTML = darkMode ? '<i class="bi bi-sun"></i>' : '<i class="bi bi-moon"></i>';

            // Sauvegarder la préférence
            localStorage.setItem('darkMode', darkMode);

            // Mettre à jour les graphiques si nécessaires
            updateChartTheme();
        }

        // Mettre à jour le thème des graphiques
        function updateChartTheme() {
            Object.values(charts).forEach(chart => {
                if (chart && typeof chart.update === 'function') {
                    // Mettre à jour les couleurs du graphique selon le thème
                    chart.options.scales.x.grid.color = darkMode ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)';
                    chart.options.scales.y.grid.color = darkMode ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)';
                    chart.options.scales.x.ticks.color = darkMode ? '#e5e5e5' : '#333';
                    chart.options.scales.y.ticks.color = darkMode ? '#e5e5e5' : '#333';
                    chart.update();
                }
            });

            // Mettre à jour Plotly 3D si présent
            var plot3dElement = document.getElementById('plot3d');
            if (plot3dElement && plot3dElement.data) {
                var paperColor = darkMode ? '#1a2530' : '#ffffff';
                var textColor = darkMode ? '#e5e5e5' : '#333333';

                Plotly.relayout(plot3dElement, {
                    'paper_bgcolor': paperColor,
                    'plot_bgcolor': paperColor,
                    'font.color': textColor,
                    'scene.xaxis.color': textColor,
                    'scene.yaxis.color': textColor,
                    'scene.zaxis.color': textColor
                });
            }
        }

        // Initialisation des événements
        function initializeEvents() {
            // Formulaire de recherche
            document.getElementById('search-form').addEventListener('submit', function(e) {
                e.preventDefault();
                searchTicker();
            });

            // Formulaire de pricing
            document.getElementById('pricing-form').addEventListener('submit', function(e) {
                e.preventDefault();
                calculatePrices();
            });

            // Filtres des options
            document.getElementById('filter-type').addEventListener('change', filterAndSortOptions);
            document.getElementById('sort-by').addEventListener('change', filterAndSortOptions);
            document.getElementById('expiry-filter').addEventListener('change', filterAndSortOptions);

            // Onglets des graphiques
            document.querySelectorAll('#chartTabs button').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    $(this).tab('show');

                    // Si c'est l'onglet de la surface 3D, redimensionner Plotly
                    if (this.id === 'surface-tab') {
                        setTimeout(() => {
                            var plot3dElement = document.getElementById('plot3d');
                            if (plot3dElement && plot3dElement.data) {
                                Plotly.relayout(plot3dElement, {});
                            }
                        }, 100);
                    }
                });
            });
        }

        // Affichage des messages d'erreur
        function showError(message) {
            const errorElement = document.getElementById('error-message');
            errorElement.textContent = message;
            errorElement.style.display = 'block';

            // Scroll vers le message d'erreur
            errorElement.scrollIntoView({ behavior: 'smooth', block: 'center' });

            // Masquer après 5 secondes
            setTimeout(() => {
                errorElement.style.display = 'none';
            }, 5000);
        }

        // Affichage du chargement
        function showLoading(message = 'Chargement...') {
            document.getElementById('loadingText').textContent = message;
            document.getElementById('loadingOverlay').classList.add('active');
        }

        function hideLoading() {
            document.getElementById('loadingOverlay').classList.remove('active');
        }

        // Recherche d'un ticker
        function searchTicker() {
            const tickerInput = document.getElementById('ticker-input');
            const ticker = tickerInput.value.trim().toUpperCase();

            if (!ticker) {
                showError('Veuillez entrer un ticker valide');
                return;
            }

            showLoading('Recherche des options disponibles...');

            // Appel API
            fetch(`/Option/Heston/search`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `ticker=${encodeURIComponent(ticker)}`
            })
            .then(response => response.json())
            .then(data => {
                hideLoading();

                if (data.success) {
                    // Mise à jour des informations
                    document.getElementById('ticker-info').style.display = 'block';
                    document.getElementById('current-spot').textContent = `$${data.spot.toFixed(2)}`;

                    // Afficher le ticker dans l'en-tête de la section des options
                    document.getElementById('options-ticker-display').textContent = data.ticker;

                    // Masquer le message "aucun ticker sélectionné"
                    document.getElementById('no-ticker-selected').style.display = 'none';
                    document.getElementById('options-content').style.display = 'block';

                    // Stockage des options
                    allOptions = data.options;

                    // Remplir les filtres d'expiration
                    populateExpiryFilter(data.options);

                    // Affichage des options
                    displayOptions(data.options);

                } else {
                    showError(data.error || 'Une erreur est survenue lors de la recherche');
                }
            })
            .catch(error => {
                hideLoading();
                console.error('Erreur:', error);
                showError('Erreur de communication avec le serveur');
            });
        }

        // Remplir le filtre des dates d'expiration
        function populateExpiryFilter(options) {
            const expiryFilter = document.getElementById('expiry-filter');
            expiryFilter.innerHTML = '<option value="all">Toutes les dates</option>';

            // Extraire les dates d'expiration uniques
            const expiryDates = [...new Set(options.map(option => option.expirationDate))];
            expiryDates.sort((a, b) => new Date(a) - new Date(b));

            // Ajouter chaque date comme option
            expiryDates.forEach(date => {
                const formattedDate = new Date(date).toLocaleDateString('fr-FR');
                const option = document.createElement('option');
                option.value = date;
                option.textContent = formattedDate;
                expiryFilter.appendChild(option);
            });
        }

        // Affichage des options dans le tableau
        function displayOptions(options) {
            const optionsTable = document.getElementById('options-table');
            optionsTable.innerHTML = '';

            if (options.length === 0) {
                optionsTable.innerHTML = '<tr><td colspan="4" class="text-center">Aucune option disponible</td></tr>';
                return;
            }

            options.forEach((option, index) => {
                const row = document.createElement('tr');
                row.classList.add('option-row');
                row.setAttribute('data-symbol', option.optionSymbol);

                // Ajouter la classe selected si c'est l'option actuellement sélectionnée
                if (option.optionSymbol === selectedOptionSymbol) {
                    row.classList.add('selected-option-row');
                }

                // Formater la date d'expiration
                const expiryDate = new Date(option.expirationDate);
                const formattedDate = expiryDate.toLocaleDateString('fr-FR');

                // Formater la maturité avec 4 décimales
                const formattedMaturity = option.maturity.toFixed(4);

                // Créer la ligne du tableau
                row.innerHTML = `
                    <td>
                        <span class="badge ${option.optionType === 'Call' ? 'bg-success' : 'bg-danger'}">
                            ${option.optionType}
                        </span>
                    </td>
                    <td>$${option.strike.toFixed(2)}</td>
                    <td>${formattedDate}</td>
                    <td>${formattedMaturity}</td>
                `;

                // Ajouter un événement de clic pour sélectionner l'option
                row.addEventListener('click', function() {
                    // Supprimer la sélection précédente
                    document.querySelectorAll('.option-row').forEach(r => {
                        r.classList.remove('selected-option-row');
                    });

                    // Ajouter la classe de sélection
                    this.classList.add('selected-option-row');

                    // Charger les détails de l'option sélectionnée
                    loadOption(this.getAttribute('data-symbol'));
                });

                optionsTable.appendChild(row);
            });
        }

        // Filtrage et tri des options
        function filterAndSortOptions() {
            const filterType = document.getElementById('filter-type').value;
            const sortBy = document.getElementById('sort-by').value;
            const expiryFilter = document.getElementById('expiry-filter').value;

            let filteredOptions = [...allOptions];

            // Filtrer par type
            if (filterType !== 'all') {
                filteredOptions = filteredOptions.filter(option => option.optionType === filterType);
            }

            // Filtrer par date d'expiration
            if (expiryFilter !== 'all') {
                filteredOptions = filteredOptions.filter(option =>
                    new Date(option.expirationDate).toISOString() === new Date(expiryFilter).toISOString()
                );
            }

            // Trier les options
            switch (sortBy) {
                case 'strike':
                    filteredOptions.sort((a, b) => a.strike - b.strike);
                    break;
                case 'expiry':
                    filteredOptions.sort((a, b) => new Date(a.expirationDate) - new Date(b.expirationDate));
                    break;
                case 'type':
                    filteredOptions.sort((a, b) => a.optionType.localeCompare(b.optionType));
                    break;
            }

            // Afficher les options filtrées
            displayOptions(filteredOptions);
        }

        // Chargement des détails d'une option
        function loadOption(optionSymbol) {
            showLoading('Chargement des détails de l\'option...');

            // Stocker l'option sélectionnée
            selectedOptionSymbol = optionSymbol;

            fetch(`/Option/Heston/details/${optionSymbol}`)
                .then(response => response.json())
                .then(data => {
                    hideLoading();

                    if (data.success === false) {
                        showError(data.error || 'Erreur lors du chargement des détails de l\'option');
                        return;
                    }

                    // Mise à jour de l'interface
                    document.getElementById('option-ticker').textContent = data.ticker;
                    document.getElementById('option-details-display').textContent = `${data.optionType} $${data.strike}`;

                    // Masquer le message "aucune option sélectionnée"
                    document.getElementById('no-option-selected').style.display = 'none';
                    document.getElementById('pricing-form').style.display = 'block';

                    // Remplir le formulaire
                    document.getElementById('option-symbol').value = data.optionSymbol;
                    document.getElementById('option-type').value = data.optionType;
                    document.getElementById('display-option-type').value = data.optionType;
                    document.getElementById('strike').value = data.strike;
                    document.getElementById('spot').value = data.spot;
                    document.getElementById('maturity').value = data.maturity;
                    document.getElementById('interest-rate').value = data.interestRate;
                    document.getElementById('volatility').value = data.v0;

                    // Paramètres spécifiques de Heston
                    updateSlider('kappa', data.kappa);
                    updateSlider('theta', data.theta);
                    updateSlider('sigma', data.sigma);
                    updateSlider('rho', data.rho);

                    // Nombre de simulations
                    document.getElementById('simulations').value = data.simulations;
                    document.getElementById('simulations-value').textContent = data.simulations.toLocaleString();

                    // Prix du marché
                    document.getElementById('market-price').textContent = data.marketPrice > 0 ?
                        `$${data.marketPrice.toFixed(2)}` : 'N/A';

                    // Réinitialiser les autres éléments
                    document.getElementById('semi-analytical-price').textContent = '--';
                    document.getElementById('montecarlo-price').textContent = '--';
                    document.getElementById('finitediff-price').textContent = '--';
                    document.getElementById('delta-value').textContent = '--';
                    document.getElementById('gamma-value').textContent = '--';
                    document.getElementById('theta-value').textContent = '--';
                    document.getElementById('vega-value').textContent = '--';

                    // Masquer la section de résultats ou afficher le message "pas de résultats"
                    document.getElementById('no-results').style.display = 'block';
                    document.getElementById('results-content').style.display = 'none';
                })
                .catch(error => {
                    hideLoading();
                    console.error('Erreur:', error);
                    showError('Erreur de communication avec le serveur');
                });
        }

        // Mettre à jour un slider et sa valeur affichée
        function updateSlider(paramName, value) {
            const slider = document.getElementById(`${paramName}-slider`);
            const valueDisplay = document.getElementById(`${paramName}-value`);
            const hiddenInput = document.getElementById(paramName);

            slider.value = value;
            valueDisplay.textContent = parseFloat(value).toFixed(2);
            hiddenInput.value = value;
        }

        // Calcul des prix
        function calculatePrices() {
            // Collecter les données du formulaire
            const formData = {
                optionSymbol: document.getElementById('option-symbol').value,
                ticker: document.getElementById('option-ticker').textContent,
                optionType: document.getElementById('option-type').value,
                strike: parseFloat(document.getElementById('strike').value),
                spot: parseFloat(document.getElementById('spot').value),
                maturity: parseFloat(document.getElementById('maturity').value),
                interestRate: parseFloat(document.getElementById('interest-rate').value),
                v0: parseFloat(document.getElementById('volatility').value),
                kappa: parseFloat(document.getElementById('kappa').value),
                theta: parseFloat(document.getElementById('theta').value),
                sigma: parseFloat(document.getElementById('sigma').value),
                rho: parseFloat(document.getElementById('rho').value),
                simulations: parseInt(document.getElementById('simulations').value)
            };

            // Vérification des valeurs
            if (isNaN(formData.spot) || formData.spot <= 0) {
                showError('Le prix du sous-jacent doit être un nombre positif');
                return;
            }
            if (isNaN(formData.interestRate)) {
                showError('Le taux sans risque doit être un nombre');
                return;
            }
            if (isNaN(formData.v0) || formData.v0 <= 0) {
                showError('La volatilité initiale doit être un nombre positif');
                return;
            }

            showLoading('Calcul des prix avec le modèle de Heston...');

            // Appel API pour le calcul
            fetch('/Option/Heston/price', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(data => {
                hideLoading();

                if (data.success) {
                    // Masquer le message "pas de résultats" et afficher la section de résultats
                    document.getElementById('no-results').style.display = 'none';
                    document.getElementById('results-content').style.display = 'block';

                    // Créer d'abord la surface 3D
                    setTimeout(() => {
                        createVolatilitySurface(data.prices.volatilitySurface);
                    }, 300);

                    // Afficher les résultats avec animation
                    setTimeout(() => {
                        // Affichage des prix avec une animation de compteur
                        animateCounter('semi-analytical-price', data.prices.semiAnalyticalPrice);
                        animateCounter('montecarlo-price', data.prices.monteCarloPrice);
                        animateCounter('finitediff-price', data.prices.finiteDifferencePrice);

                        // Affichage des Greeks
                        animateCounter('delta-value', data.prices.delta, false);
                        animateCounter('gamma-value', data.prices.gamma, false);
                        animateCounter('theta-value', data.prices.thetaGreek, false);
                        animateCounter('vega-value', data.prices.vega, false);
                    }, 600);

                    // Créer les autres graphiques avec un délai
                    setTimeout(() => {
                        // Créer les graphiques
                        createCharts(data.prices);
                    }, 900);
                } else {
                    showError(data.error || 'Erreur lors du calcul des prix');
                }
            })
            .catch(error => {
                hideLoading();
                console.error('Erreur:', error);
                showError('Erreur de communication avec le serveur');
            });
        }

        // Animation de compteur pour les prix et les Greeks
        function animateCounter(elementId, finalValue, isCurrency = true) {
            const element = document.getElementById(elementId);
            if (!element || finalValue === undefined) return;

            // Réinitialiser la valeur
            if (isCurrency) {
                element.textContent = '$0.00';
            } else {
                element.textContent = '0.0000';
            }

            const duration = 1000; // 1 seconde d'animation
            const frameDuration = 1000/60; // 60 fps
            const totalFrames = Math.round(duration / frameDuration);

            // Valeur absolue pour le calcul de l'incrément
            const absValue = Math.abs(finalValue);
            const valueIncrement = absValue / totalFrames;

            let currentFrame = 0;
            let currentValue = 0;
            // Déterminer le sens de l'animation (positif ou négatif)
            const isNegative = finalValue < 0;

            // Fonction d'animation avec easing
            const animate = () => {
                currentFrame++;

                // Appliquer une courbe d'accélération/décélération pour une animation plus fluide
                const progress = currentFrame / totalFrames;
                // Fonction easing: accélération au début, décélération à la fin
                const easingFactor = progress < 0.5
                    ? 4 * progress * progress * progress
                    : 1 - Math.pow(-2 * progress + 2, 3) / 2;

                // Calculer la valeur actuelle avec easing
                currentValue = absValue * easingFactor;

                // Si on est à la dernière image, utiliser la valeur finale exacte
                if (currentFrame === totalFrames) {
                    currentValue = absValue;
                }

                // Appliquer le signe si négatif
                const displayValue = isNegative ? -currentValue : currentValue;

                // Formater et afficher la valeur
                if (isCurrency) {
                    element.textContent = `$${displayValue.toFixed(2)}`;
                } else {
                    element.textContent = displayValue.toFixed(4);
                }

                // Continuer l'animation si pas terminée
                if (currentFrame < totalFrames) {
                    requestAnimationFrame(animate);
                } else {
                    // Animation terminée - ajouter un petit effet de rebond
                    element.style.transform = 'scale(1.05)';
                    setTimeout(() => {
                        element.style.transition = 'transform 0.2s ease-out';
                        element.style.transform = 'scale(1)';
                    }, 50);
                }
            };

            // Démarrer l'animation
            element.style.transition = 'none';
            requestAnimationFrame(animate);
        }

        // Fonction pour créer les graphiques
        function createCharts(prices) {
            // Détruire les graphiques existants s'ils existent
            Object.values(charts).forEach(chart => {
                if (chart) chart.destroy();
            });

            // Configuration commune pour tous les graphiques
            const chartConfig = {
                responsive: true,
                maintainAspectRatio: false,
                animation: {
                    duration: 1000
                },
                plugins: {
                    legend: {
                        labels: {
                            color: darkMode ? '#e5e5e5' : '#333'
                        }
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        backgroundColor: darkMode ? '#2c3e50' : 'white',
                        titleColor: darkMode ? '#ecf0f1' : '#2c3e50',
                        bodyColor: darkMode ? '#ecf0f1' : '#2c3e50',
                        borderColor: darkMode ? '#1a2530' : '#e9ecef',
                        borderWidth: 1
                    }
                },
                scales: {
                    x: {
                        grid: {
                            color: darkMode ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)'
                        },
                        ticks: {
                            color: darkMode ? '#e5e5e5' : '#333'
                        }
                    },
                    y: {
                        grid: {
                            color: darkMode ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)'
                        },
                        ticks: {
                            color: darkMode ? '#e5e5e5' : '#333'
                        }
                    }
                }
            };

            // 1. Graphique par prix du sous-jacent
            const spotCtx = document.getElementById('spot-chart').getContext('2d');

            // Générer des points pour le graphique spot
            const baseSpot = parseFloat(document.getElementById('spot').value);
            const spotPoints = [];
            const spotRange = baseSpot * 0.4; // 40% de variation autour du prix actuel

            for (let i = -10; i <= 10; i++) {
                spotPoints.push(baseSpot + (spotRange * i / 10));
            }

            const spotData = {
                labels: spotPoints.map(spot => spot.toFixed(2)),
                datasets: [
                    {
                        label: 'Semi-analytique',
                        data: spotPoints.map(spot => calculateAnalyticalPrice(spot, prices.semiAnalyticalPrice, prices.delta, prices.gamma)),
                        borderColor: '#3498db',
                        backgroundColor: 'rgba(52, 152, 219, 0.2)',
                        borderWidth: 2,
                        tension: 0.4,
                        pointRadius: 3
                    },
                    {
                        label: 'Monte Carlo',
                        data: spotPoints.map(spot => calculateAnalyticalPrice(spot, prices.monteCarloPrice, prices.delta, prices.gamma) + (Math.random() * 0.02 - 0.01)),
                        borderColor: '#2ecc71',
                        backgroundColor: 'rgba(46, 204, 113, 0.2)',
                        borderWidth: 2,
                        tension: 0.4,
                        pointRadius: 3
                    }
                ]
            };

            charts.spot = new Chart(spotCtx, {
                type: 'line',
                data: spotData,
                options: {
                    ...chartConfig,
                    plugins: {
                        ...chartConfig.plugins,
                        title: {
                            display: true,
                            text: 'Prix de l\'option par rapport au prix du sous-jacent',
                            color: darkMode ? '#e5e5e5' : '#333'
                        }
                    }
                }
            });

            // 2. Graphique par volatilité
            const volCtx = document.getElementById('volatility-chart').getContext('2d');

            // Générer des points pour le graphique de volatilité
            const baseVol = parseFloat(document.getElementById('volatility').value);
            const volPoints = [];

            for (let i = 0; i <= 20; i++) {
                volPoints.push(5 + i * 2); // Volatilité de 5% à 45%
            }

            const volData = {
                labels: volPoints.map(vol => vol + '%'),
                datasets: [
                    {
                        label: 'Semi-analytique',
                        data: volPoints.map(vol => calculateVolatilityPrice(vol, prices.semiAnalyticalPrice, prices.vega, baseVol)),
                        borderColor: '#3498db',
                        backgroundColor: 'rgba(52, 152, 219, 0.2)',
                        borderWidth: 2,
                        tension: 0.4,
                        pointRadius: 3
                    }
                ]
            };

            charts.volatility = new Chart(volCtx, {
                type: 'line',
                data: volData,
                options: {
                    ...chartConfig,
                    plugins: {
                        ...chartConfig.plugins,
                        title: {
                            display: true,
                            text: 'Prix de l\'option par rapport à la volatilité initiale',
                            color: darkMode ? '#e5e5e5' : '#333'
                        }
                    }
                }
            });

            // 3. Graphique par temps jusqu'à expiration
            const timeCtx = document.getElementById('time-chart').getContext('2d');

            // Générer des points pour le graphique de temps
            const baseMaturity = parseFloat(document.getElementById('maturity').value);
            const maxMaturity = Math.max(baseMaturity, 1); // Au moins 1 an pour le graphique
            const timePoints = [];

            for (let i = 0; i <= 10; i++) {
                timePoints.push(maxMaturity * i / 10);
            }

            const timeData = {
                labels: timePoints.map(t => (t * 365).toFixed(0) + ' jours'),
                datasets: [
                    {
                        label: 'Semi-analytique',
                        data: timePoints.map(t => calculateTimePrice(t, prices.semiAnalyticalPrice, prices.thetaGreek, baseMaturity)),
                        borderColor: '#3498db',
                        backgroundColor: 'rgba(52, 152, 219, 0.2)',
                        borderWidth: 2,
                        tension: 0.4,
                        pointRadius: 3
                    }
                ]
            };

            charts.time = new Chart(timeCtx, {
                type: 'line',
                data: timeData,
                options: {
                    ...chartConfig,
                    plugins: {
                        ...chartConfig.plugins,
                        title: {
                            display: true,
                            text: 'Prix de l\'option par rapport au temps jusqu\'à expiration',
                            color: darkMode ? '#e5e5e5' : '#333'
                        }
                    }
                }
            });
        }

        // Fonction pour créer la surface de volatilité 3D
        function createVolatilitySurface(surfaceData) {
            // Vérifier que les données de surface sont disponibles
            if (!surfaceData || !surfaceData.strikes || !surfaceData.maturities || !surfaceData.impliedVolatilities) {
                console.error('Données de surface manquantes');
                return;
            }

            // Configurer les données pour Plotly en fonction du type de surface
            let plotData = [];

            // Déterminer le titre et les labels des axes en fonction du type de surface
            let title = currentSurfaceType === 'volatility' ?
                'Surface de volatilité implicite' : 'Surface de prix d\'option';

            let zAxisTitle = currentSurfaceType === 'volatility' ?
                'Volatilité (%)' : 'Prix ($)';

            // Valeurs pour la coloration
            let zValues = currentSurfaceType === 'volatility' ?
                surfaceData.impliedVolatilities :
                // Simuler des prix d'options basés sur les volatilités
                surfaceData.impliedVolatilities.map((vol, i) => {
                    const strike = surfaceData.strikes[i];
                    const maturity = surfaceData.maturities[i];
                    // Formule simplifiée basée sur les valeurs de volatilité
                    return 2 + 0.1 * vol * Math.sqrt(maturity) * (1 - Math.abs(1 - strike / parseFloat(document.getElementById('spot').value)));
                });

            // Configuration du graphique 3D
            plotData = [{
                type: 'mesh3d',
                x: surfaceData.strikes,
                y: surfaceData.maturities,
                z: currentSurfaceType === 'volatility' ? surfaceData.impliedVolatilities : zValues,
                intensity: zValues,
                colorscale: currentSurfaceType === 'volatility' ? 'Jet' : 'Viridis',
                opacity: 0.8
            }];

            // Configuration du graphique 3D
            const layout = {
                title: title,
                scene: {
                    xaxis: {title: 'Prix d\'exercice'},
                    yaxis: {title: 'Maturité (années)'},
                    zaxis: {title: zAxisTitle}
                },
                margin: {l: 0, r: 0, b: 0, t: 50},
                paper_bgcolor: darkMode ? '#1a2530' : '#ffffff',
                plot_bgcolor: darkMode ? '#1a2530' : '#ffffff',
                font: {
                    color: darkMode ? '#e5e5e5' : '#333333'
                }
            };

            // Créer ou mettre à jour le graphique Plotly
            Plotly.newPlot('plot3d', plotData, layout);
        }

        // Mettre à jour la surface 3D
        function updateVolatilitySurface() {
            // Récupérer les données de surface actuelles
            const plot3dElement = document.getElementById('plot3d');
            if (plot3dElement && plot3dElement.data && plot3dElement.data[0]) {
                const data = plot3dElement.data[0];

                // Mettre à jour le titre et l'axe Z
                const title = currentSurfaceType === 'volatility' ?
                    'Surface de volatilité implicite' : 'Surface de prix d\'option';

                const zAxisTitle = currentSurfaceType === 'volatility' ?
                    'Volatilité (%)' : 'Prix ($)';

                // Simuler les valeurs de prix si nécessaire
                if (currentSurfaceType === 'price' && data.x && data.y) {
                    const strikes = data.x;
                    const maturities = data.y;
                    const vols = data.z; // Volatilités originales

                    // Convertir les volatilités en prix pour la visualisation
                    const prices = vols.map((vol, i) => {
                        const strike = strikes[i];
                        const maturity = maturities[i];
                        // Formule simplifiée basée sur les valeurs de volatilité
                        return 2 + 0.1 * vol * Math.sqrt(maturity) * (1 - Math.abs(1 - strike / parseFloat(document.getElementById('spot').value)));
                    });

                    Plotly.restyle(plot3dElement, {
                        'z': [currentSurfaceType === 'volatility' ? vols : prices],
                        'intensity': [prices],
                        'colorscale': currentSurfaceType === 'volatility' ? 'Jet' : 'Viridis'
                    });
                }

                // Mettre à jour les titres
                Plotly.relayout(plot3dElement, {
                    'title': title,
                    'scene.zaxis.title': zAxisTitle
                });
            }
        }

        // Fonctions d'estimation des prix pour différents scénarios
        function calculateAnalyticalPrice(spot, basePrice, delta, gamma) {
            // Formule approximative de Taylor
            const baseSpot = parseFloat(document.getElementById('spot').value);
            const dSpot = spot - baseSpot;
            return Math.max(0, basePrice + delta * dSpot + 0.5 * gamma * dSpot * dSpot);
        }

        function calculateVolatilityPrice(vol, basePrice, vega, baseVol) {
            // Formule approximative avec vega
            const dVol = (vol - baseVol) / 100; // Convertir en décimal
            return Math.max(0, basePrice + vega * dVol);
        }

        function calculateTimePrice(time, basePrice, theta, baseMaturity) {
            // Formule approximative avec theta
            const dTime = time - baseMaturity;
            return Math.max(0, basePrice - theta * dTime);
        }

        // Animation de la page au chargement initial
        window.addEventListener('load', function() {
            // Créer un effet de chargement progressif
            const mainSections = document.querySelectorAll('.card');
            mainSections.forEach((section, index) => {
                setTimeout(() => {
                    section.style.opacity = '1';
                }, index * 100);
            });

            // Animation du titre de l'application
            const appTitle = document.querySelector('.app-title');
            if (appTitle) {
                appTitle.style.opacity = '0';
                appTitle.style.transform = 'translateY(-20px)';

                setTimeout(() => {
                    appTitle.style.transition = 'all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
                    appTitle.style.opacity = '1';
                    appTitle.style.transform = 'translateY(0)';
                }, 200);
            }

            // Mise à jour de la date et de l'utilisateur
            updateTimestampAndUser();
        });

        // Mise à jour de la date et de l'utilisateur
        function updateTimestampAndUser() {
            const timestampElements = document.querySelectorAll('.timestamp');
            const userElements = document.querySelectorAll('.user');

            timestampElements.forEach(el => {
                el.textContent = '2025-05-01 08:41:05';
            });

            userElements.forEach(el => {
                el.textContent = 'hajji-achraf';
            });
        }

        // Optimisations pour les appareils mobiles
        function setupMobileOptimizations() {
            // Vérifier si l'appareil est mobile (écran < 768px)
            const isMobile = window.innerWidth < 768;

            if (isMobile) {
                // Ajuster la taille des graphiques
                document.querySelectorAll('.chart-container').forEach(container => {
                    container.style.height = '250px';
                });

                // Simplifier l'interface
                document.querySelectorAll('.greek-description').forEach(desc => {
                    desc.style.display = 'none';
                });

                // Adapter la grille unifiée pour mobile
                document.querySelector('.unified-container').style.display = 'block';
            }
        }

        // Appeler l'optimisation pour mobiles au chargement et au redimensionnement
        window.addEventListener('load', setupMobileOptimizations);
        window.addEventListener('resize', setupMobileOptimizations);
    </script>
